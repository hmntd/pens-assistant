includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 5

    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        - '#invalid type Grpc\\InterceptorChannel#'
        - '#invalid type Google\\Protobuf\\Internal\\RepeatedField#'
        - '#Google\\Protobuf\\Internal\\RepeatedField#'
        - '#Grpc\\InterceptorChannel#'
        - '#Google\\Protobuf\\Internal\\GPBUtil::checkEnum#'
        - '#unset\.possiblyHookedProperty#'
        - '#Cannot unset property#'
        - '#Property .is_admin. does not exist in model#'
